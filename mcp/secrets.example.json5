{
  // This key must be configured as a named API key in the main CryptoTracker
  // API and should not be reused by an MCP client.
  upstreamApiKey: 'replace-with-a-dedicated-upstream-api-key',
  // upstreamApiKeyFile: '/run/secrets/cryptotracker-mcp-upstream-key',

  // MCP clients send these as Authorization: Bearer values.
  clientApiKeys: [
    {
      name: 'mcp-reader',
      key: 'replace-with-a-distinct-reader-api-key',
      // keyFile: '/run/secrets/cryptotracker-mcp-reader-key',
      role: 'read',
    },
    {
      name: 'mcp-automation',
      key: 'replace-with-a-distinct-readwrite-api-key',
      role: 'readwrite',
    },
  ],
}
