{
  publicBaseUrl: 'https://crypto.example.ca',
  api: {
    trustProxy: true,
  },
  auth: {
    local: {
      enabled: false,
    },
    header: {
      enabled: true,
      trustedCidrs: ['10.42.0.0/16'],
      usernameHeader: 'Remote-User',
      groupsHeader: 'Remote-Groups',
      groupsSeparator: ',',
      allowedUsers: ['operator'],
      allowedGroups: ['crypto-viewers'],
      signedIdentity: {
        enabled: true,
        headerName: 'X-Oauth-Identity',
        issuer: 'https://oauth.example.ca',
        audience: 'cryptotracker',
        // The upstream issuer must set iat and exp; CryptoTracker rejects TTLs over one year.
        maxTokenTtlSeconds: 31536000,
      },
    },
  },
}
